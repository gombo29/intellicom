<!DOCTYPE html>
<html lang="{{ app.request.locale|default('mn') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="{{ asset('favicon.ico') }}" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('favicon-32.png') }}">
    <link rel="apple-touch-icon" href="{{ asset('apple-touch-icon.png') }}">
    <link rel="manifest" href="{{ asset('site.webmanifest') }}">
    <meta name="theme-color" content="#0a2947">
    <title>{% block title %}{{ 'site.title'|trans }}{% endblock %}</title>
    <meta name="description" content="{% block description %}{{ 'site.description'|trans }}{% endblock %}">
    <link rel="canonical" href="{{ url('app_home') }}">

    {# Facebook / Open Graph #}
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ 'site.company'|trans }}">
    <meta property="og:url" content="{{ url('app_home') }}">
    <meta property="og:title" content="{{ 'site.title'|trans }}">
    <meta property="og:description" content="{{ 'site.description'|trans }}">
    <meta property="og:image" content="{{ absolute_url(asset('assets/img/og-image.jpg')) }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="{{ 'site.company'|trans }}">
    <meta property="og:locale" content="{{ app.request.locale == 'en' ? 'en_US' : 'mn_MN' }}">
    <meta property="og:locale:alternate" content="{{ app.request.locale == 'en' ? 'mn_MN' : 'en_US' }}">

    {# Twitter / X #}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ 'site.title'|trans }}">
    <meta name="twitter:description" content="{{ 'site.description'|trans }}">
    <meta name="twitter:image" content="{{ absolute_url(asset('assets/img/og-image.jpg')) }}">
    {% for locale in locales %}
        <link rel="alternate" hreflang="{{ locale }}" href="{{ url('app_home', {_locale: locale}) }}">
    {% endfor %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Golos+Text:wght@400;500;600;700;800;900&family=Nunito:wght@800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('assets/css/app.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
{% block body %}{% endblock %}
<script src="{{ asset('assets/js/app.js') }}" defer></script>
{% block javascripts %}{% endblock %}
</body>
</html>
