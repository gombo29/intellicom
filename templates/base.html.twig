<!DOCTYPE html>
<html lang="{{ app.request.locale|default('mn') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ 'site.title'|trans }}{% endblock %}</title>
    {% for locale in locales %}
        <link rel="alternate" hreflang="{{ locale }}" href="{{ url('app_home', {_locale: locale}) }}">
    {% endfor %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&family=Golos+Text:wght@400;500;600;700;800;900&family=Nunito:wght@800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('assets/css/app.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
{% block body %}{% endblock %}
<script src="{{ asset('assets/js/app.js') }}" defer></script>
{% block javascripts %}{% endblock %}
</body>
</html>
