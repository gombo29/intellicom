{% extends 'base.html.twig' %}

{% block body %}
<header class="site-header">
  <div class="container inner">
    <a href="#top"><img src="{{ asset('assets/img/logo.png') }}" alt="IntelliCom"></a>
    <nav class="site-nav">
      <a href="#services">{{ 'nav.services'|trans }}</a>
      <a href="#erp">{{ 'nav.erp'|trans }}</a>
      <a href="#about">{{ 'nav.about'|trans }}</a>
      <a href="#partners">{{ 'nav.partners'|trans }}</a>
      <a href="#contact" class="cta">{{ 'nav.contact'|trans }}</a>
      {% set otherLocale = locales|filter(l => l != app.request.locale)|first|default('en') %}
      <a href="{{ path('app_home', {_locale: otherLocale}) }}" class="lang-switch"
         title="{{ 'nav.lang_switch_title'|trans }}" hreflang="{{ otherLocale }}">
        <svg width="15" height="15" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="10" cy="10" r="7.6" stroke="currentColor" stroke-width="1.5"/>
          <ellipse cx="10" cy="10" rx="3.2" ry="7.6" stroke="currentColor" stroke-width="1.5"/>
          <line x1="2.7" y1="7.6" x2="17.3" y2="7.6" stroke="currentColor" stroke-width="1.5"/>
          <line x1="2.7" y1="12.4" x2="17.3" y2="12.4" stroke="currentColor" stroke-width="1.5"/>
        </svg>{{ 'nav.lang_switch'|trans }}
      </a>
    </nav>
  </div>
</header>

<section id="top" class="hero">
  <div class="hero-pattern"></div>
  <div class="container inner">
    <div data-reveal>
      <h1>{{ 'hero.title'|trans }}</h1>
      <p class="lede">{{ 'hero.lede'|trans }}</p>
      <div class="btn-row">
        <a href="#contact" class="btn btn-primary">{{ 'hero.cta_primary'|trans }}</a>
        <a href="#services" class="btn btn-ghost">{{ 'hero.cta_secondary'|trans }}</a>
      </div>
    </div>
    <div class="orbital" data-reveal>
      <div class="orbital-glow"></div>
      <div class="ring ring-outer">
        <div class="pos-top"><div class="chip"><svg width="18" height="18" viewBox="0 0 20 20" fill="none"><ellipse cx="10" cy="5" rx="6.5" ry="2.8" stroke="#7fd3e4" stroke-width="1.4"/><line x1="3.5" y1="5" x2="3.5" y2="15" stroke="#7fd3e4" stroke-width="1.4"/><line x1="16.5" y1="5" x2="16.5" y2="15" stroke="#7fd3e4" stroke-width="1.4"/><ellipse cx="10" cy="15" rx="6.5" ry="2.8" stroke="#7fd3e4" stroke-width="1.4"/></svg></div></div>
        <div class="pos-right"><div class="chip"><svg width="16" height="16" viewBox="0 0 20 20" fill="none"><rect x="2" y="2" width="7" height="7" fill="#7fd3e4"/><rect x="11" y="2" width="7" height="7" fill="#7fd3e4" opacity=".65"/><rect x="2" y="11" width="7" height="7" fill="#7fd3e4" opacity=".65"/><rect x="11" y="11" width="7" height="7" fill="#7fd3e4"/></svg></div></div>
        <div class="pos-bottom"><div class="chip"><svg width="18" height="18" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="4.5" r="2.6" stroke="#7fd3e4" stroke-width="1.4"/><circle cx="4.5" cy="15" r="2.6" stroke="#7fd3e4" stroke-width="1.4"/><circle cx="15.5" cy="15" r="2.6" stroke="#7fd3e4" stroke-width="1.4"/><line x1="8.7" y1="6.8" x2="5.6" y2="12.8" stroke="#7fd3e4" stroke-width="1.4"/><line x1="11.3" y1="6.8" x2="14.4" y2="12.8" stroke="#7fd3e4" stroke-width="1.4"/><line x1="7.1" y1="15" x2="12.9" y2="15" stroke="#7fd3e4" stroke-width="1.4"/></svg></div></div>
        <div class="pos-left"><div class="chip"><svg width="18" height="18" viewBox="0 0 20 20" fill="none"><rect x="2" y="5" width="12" height="7" rx="1.5" stroke="#7fd3e4" stroke-width="1.4"/><circle cx="8" cy="8.5" r="2" stroke="#7fd3e4" stroke-width="1.3"/><line x1="14" y1="7.5" x2="18" y2="6" stroke="#7fd3e4" stroke-width="1.4"/><line x1="14" y1="9.5" x2="18" y2="11" stroke="#7fd3e4" stroke-width="1.4"/><line x1="6" y1="12" x2="6" y2="16" stroke="#7fd3e4" stroke-width="1.4"/></svg></div></div>
        <div class="pos-tr"><div class="chip"><svg width="17" height="17" viewBox="0 0 20 20" fill="none"><rect x="4" y="9" width="12" height="8" rx="1.5" stroke="#7fd3e4" stroke-width="1.4"/><circle cx="10" cy="6" r="3.6" stroke="#7fd3e4" stroke-width="1.4" fill="#0a2947"/><circle cx="10" cy="13" r="1.4" fill="#7fd3e4"/></svg></div></div>
        <div class="pos-tl"><div class="chip"><svg width="18" height="18" viewBox="0 0 20 20" fill="none"><circle cx="8" cy="10" r="4.4" stroke="#7fd3e4" stroke-width="1.4"/><circle cx="13.2" cy="11.4" r="3.1" stroke="#7fd3e4" stroke-width="1.4"/><line x1="6" y1="14.4" x2="15.5" y2="14.4" stroke="#7fd3e4" stroke-width="1.4"/></svg></div></div>
        <div class="pos-br"><div class="chip"><svg width="17" height="17" viewBox="0 0 20 20" fill="none"><rect x="5" y="5" width="10" height="10" rx="1.5" stroke="#7fd3e4" stroke-width="1.4"/><rect x="8" y="8" width="4" height="4" fill="#7fd3e4"/><line x1="7" y1="5" x2="7" y2="2" stroke="#7fd3e4" stroke-width="1.3"/><line x1="10" y1="5" x2="10" y2="2" stroke="#7fd3e4" stroke-width="1.3"/><line x1="13" y1="5" x2="13" y2="2" stroke="#7fd3e4" stroke-width="1.3"/><line x1="7" y1="18" x2="7" y2="15" stroke="#7fd3e4" stroke-width="1.3"/><line x1="10" y1="18" x2="10" y2="15" stroke="#7fd3e4" stroke-width="1.3"/><line x1="13" y1="18" x2="13" y2="15" stroke="#7fd3e4" stroke-width="1.3"/><line x1="5" y1="7" x2="2" y2="7" stroke="#7fd3e4" stroke-width="1.3"/><line x1="5" y1="10" x2="2" y2="10" stroke="#7fd3e4" stroke-width="1.3"/><line x1="5" y1="13" x2="2" y2="13" stroke="#7fd3e4" stroke-width="1.3"/><line x1="15" y1="7" x2="18" y2="7" stroke="#7fd3e4" stroke-width="1.3"/><line x1="15" y1="10" x2="18" y2="10" stroke="#7fd3e4" stroke-width="1.3"/><line x1="15" y1="13" x2="18" y2="13" stroke="#7fd3e4" stroke-width="1.3"/></svg></div></div>
      </div>
      <div class="ring ring-inner">
        <div class="pos-inner-tr"><div class="chip"><svg width="16" height="16" viewBox="0 0 20 20" fill="none"><circle cx="8" cy="10" r="4.2" stroke="#7fd3e4" stroke-width="1.4"/><circle cx="13" cy="11.5" r="3" stroke="#7fd3e4" stroke-width="1.4"/><line x1="6" y1="14.2" x2="15" y2="14.2" stroke="#7fd3e4" stroke-width="1.4"/></svg></div></div>
        <div class="pos-inner-bl"><div class="chip"><svg width="16" height="16" viewBox="0 0 20 20" fill="none"><rect x="3" y="3" width="14" height="9" rx="1.5" stroke="#7fd3e4" stroke-width="1.4"/><line x1="10" y1="12" x2="10" y2="16" stroke="#7fd3e4" stroke-width="1.4"/><line x1="6" y1="16.3" x2="14" y2="16.3" stroke="#7fd3e4" stroke-width="1.4"/></svg></div></div>
        <div class="ring-dot"></div>
      </div>
      <div class="orbital-center">
        <img src="{{ asset('assets/img/logo.png') }}" alt="IntelliCom">
      </div>
    </div>
  </div>
  <div class="stats">
    <div class="container inner">
      <div data-reveal><div class="stat-num" data-count="20" data-suffix="+">20+</div><div class="stat-label">{{ 'stats.years'|trans }}</div></div>
      <div data-reveal><div class="stat-num" data-count="15" data-suffix="+">15+</div><div class="stat-label">{{ 'stats.team'|trans }}</div></div>
      <div data-reveal><div class="stat-num"><span class="odoo-wordmark" style="font-size:34px">odoo</span></div><div class="stat-label">{{ 'stats.odoo'|trans }}</div></div>
      <div data-reveal><div class="stat-num" style="gap:9px"><span class="ms-squares"><span></span><span></span><span></span><span></span></span><span style="font-family:Montserrat,sans-serif;font-weight:700;font-size:21px;color:#fff">Microsoft 365</span></div><div class="stat-label">{{ 'stats.microsoft'|trans }}</div></div>
    </div>
  </div>
</section>

<section id="services" class="section-light">
  <div class="container">
    <div class="eyebrow">{{ 'services.eyebrow'|trans }}</div>
    <div class="services-head" data-reveal>
      <h2 class="section-title" style="max-width:560px">{{ 'services.title'|trans }}</h2>
      <p>{{ 'services.lede'|trans }}</p>
    </div>
    <div class="services-grid">
      {% for i in services %}
      <div class="service-card" data-reveal>
        <div class="service-num">{{ '%02d'|format(i) }}</div>
        <div class="service-title">{{ ('services.item.' ~ i ~ '.title')|trans }}</div>
        <div class="service-desc">{{ ('services.item.' ~ i ~ '.desc')|trans }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section id="erp" class="section-dark">
  <div class="hero-pattern" style="animation:none"></div>
  <div class="container erp-grid">
    <div data-reveal>
      <div class="eyebrow">{{ 'erp.eyebrow'|trans }}</div>
      <h2 class="section-title" style="margin-bottom:18px">{{ 'erp.title'|trans }}</h2>
      <p class="lede">{{ 'erp.lede'|trans }}</p>
      <div class="feature-list">
        <div><span class="bullet"></span><span>{{ 'erp.feature_1'|trans }}</span></div>
        <div><span class="bullet"></span><span>{{ 'erp.feature_2'|trans }}</span></div>
        <div><span class="bullet"></span><span>{{ 'erp.feature_3'|trans }}</span></div>
      </div>
      <div class="odoo-badge"><span class="wordmark">odoo</span><span class="label">Ready Partner</span></div>
    </div>
    <div data-reveal>
      <div class="list-label">{{ 'erp.clients_label'|trans }}</div>
      <div class="client-list">
        {% for i in erpClients %}
        <div class="client-card">
          <div class="name">{{ ('erp.client.' ~ i ~ '.name')|trans }}</div>
          <div class="desc">{{ ('erp.client.' ~ i ~ '.desc')|trans }}</div>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<section id="about" class="section-white">
  <div class="container about-grid">
    <div class="about-photos" data-reveal>
      <div class="photo-slot wide"><span class="hint">{{ 'about.photo_team'|trans }}</span></div>
      <div class="photo-slot"><span class="hint">{{ 'about.photo_network'|trans }}</span></div>
      <div class="photo-slot"><span class="hint">{{ 'about.photo_server'|trans }}</span></div>
    </div>
    <div class="about-text" data-reveal>
      <div class="eyebrow">{{ 'about.eyebrow'|trans }}</div>
      <h2 class="section-title" style="margin-bottom:18px">{{ 'about.title'|trans }}</h2>
      <p>{{ 'about.p1'|trans }}</p>
      <p>{{ 'about.p2'|trans }}</p>
      <div class="values-grid">
        <div class="value-chip"><svg width="28" height="28" viewBox="0 0 20 20" fill="none"><circle cx="6.5" cy="7" r="3.5" stroke="#1a9ab5" stroke-width="1.5"/><circle cx="13.5" cy="7" r="3.5" stroke="#1a9ab5" stroke-width="1.5"/><polygon points="10,10 6.5,10.5 10,16.5 13.5,10.5" fill="#1a9ab5" opacity=".9"/></svg>{{ 'about.value_respect'|trans }}</div>
        <div class="value-chip"><svg width="28" height="28" viewBox="0 0 20 20" fill="none"><polygon points="10,2.5 16.5,5 16.5,10 10,17.5 3.5,10 3.5,5" stroke="#1a9ab5" stroke-width="1.5" fill="none"/><polyline points="7,9.5 9.2,11.8 13.2,7.5" stroke="#1a9ab5" stroke-width="1.5" fill="none"/></svg>{{ 'about.value_integrity'|trans }}</div>
        <div class="value-chip"><svg width="28" height="28" viewBox="0 0 20 20" fill="none"><polygon points="10,2 12,8 18,10 12,12 10,18 8,12 2,10 8,8" stroke="#1a9ab5" stroke-width="1.5" fill="none"/><circle cx="10" cy="10" r="1.4" fill="#1a9ab5"/></svg>{{ 'about.value_creative'|trans }}</div>
        <div class="value-chip"><svg width="28" height="28" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="7.5" stroke="#1a9ab5" stroke-width="1.5"/><polyline points="6.5,10 9,12.6 13.7,7.3" stroke="#1a9ab5" stroke-width="1.5" fill="none"/></svg>{{ 'about.value_responsible'|trans }}</div>
      </div>
    </div>
  </div>
</section>

<section class="section-light">
  <div class="container">
    <div class="eyebrow">{{ 'timeline.eyebrow'|trans }}</div>
    <h2 class="section-title">{{ 'timeline.title'|trans }}</h2>
    <div class="timeline-grid">
      {% for i in milestones %}
      <div class="milestone" data-reveal>
        <div class="year">{{ ('timeline.item.' ~ i ~ '.year')|trans }}</div>
        <div class="text">{{ ('timeline.item.' ~ i ~ '.text')|trans }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section id="partners" class="partners">
  <div class="container">
    <div class="eyebrow">{{ 'partners.eyebrow'|trans }}</div>
    <div class="partner-row" data-reveal>
      <div class="partner-pill"><span class="wordmark">odoo</span><span class="label">{{ 'partners.odoo_label'|trans }}</span></div>
      <div class="partner-pill"><span class="ms">Microsoft 365</span><span class="label">{{ 'partners.microsoft_label'|trans }}</span></div>
    </div>
  </div>
</section>

<section id="contact" class="contact">
  <div class="container inner">
    <div data-reveal>
      <h2>{{ 'contact.title'|trans }}</h2>
      <p class="lede">{{ 'contact.lede'|trans }}</p>
      <div class="btn-row">
        <a href="mailto:info@intellicom.mn" class="btn btn-primary">{{ 'contact.cta_email'|trans }}</a>
        <a href="tel:+97670000000" class="btn btn-ghost">{{ 'contact.cta_call'|trans }}</a>
      </div>
    </div>
    <div class="contact-cards" data-reveal>
      <div class="contact-card">
        <div class="label">{{ 'contact.label_address'|trans }}</div>
        <div class="value">{{ 'contact.address'|trans|raw }}</div>
      </div>
      <div class="contact-pair">
        <div class="contact-card">
          <div class="label">{{ 'contact.label_email'|trans }}</div>
          <div class="value">info@intellicom.mn</div>
        </div>
        <div class="contact-card">
          <div class="label">{{ 'contact.label_phone'|trans }}</div>
          <div class="value">+976 7000-0000</div>
        </div>
      </div>
    </div>
  </div>
</section>

<footer class="site-footer">
  <div class="container inner">
    <div class="brand">
      <img src="{{ asset('assets/img/logo.png') }}" alt="IntelliCom">
      <span>{{ 'site.copyright'|trans({'%year%': 'now'|date('Y')}) }}</span>
    </div>
    <div class="slogan">«{{ 'site.slogan'|trans }}»</div>
  </div>
</footer>
{% endblock %}
